---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="MCCA Ventures">
  <section class="hero">
    <div class="hero-content">
      <h1>We build thoughtful apps for everyday life.</h1>

      <p class="lead">
        We create mobile apps that are fast, intuitive, and enjoyable to use.
        From quick games to everyday utilities our goal is simple:
        build software people come back to.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    text-align: center;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .lead {
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    max-width: 620px;
    margin: 0 auto;
  }
</style>
